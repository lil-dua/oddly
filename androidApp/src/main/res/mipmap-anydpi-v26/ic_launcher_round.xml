<?xml version="1.0" encoding="utf-8"?>
<!--
  The layers are bitmaps rather than vectors: AGP 9's resource pipeline drops a
  vector carrying an inline `aapt:attr` gradient, and the brand sweep needs one.
  Regenerate every layer with: swift tools/IconRenderer.swift .
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
