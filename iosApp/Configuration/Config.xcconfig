// Signing identity.
//
// TEAM_ID must be filled in before an App Store build — find it in the Apple
// Developer portal under Membership. It is deliberately blank in the repository
// so no one's team is committed.
TEAM_ID=

PRODUCT_NAME=Oddly

// No $(TEAM_ID) suffix: that is a KMP-template trick so several developers can
// install side by side, and it would ship a bundle id nobody registered.
PRODUCT_BUNDLE_IDENTIFIER=dev.lildua.oddly

// MARKETING_VERSION and CURRENT_PROJECT_VERSION live in one shared file (Android reads it too).
#include "Version.xcconfig"
