# Copy to `keystore.properties` (gitignored) and fill in before a release build.
# Generate the upload key once with:
#
#   keytool -genkeypair -v -keystore upload.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then enrol it in Play App Signing. Keep upload.jks and this file out of git —
# losing the key means you can never update the listing.
storeFile=upload.jks
storePassword=
keyAlias=upload
keyPassword=
